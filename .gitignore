# Build output
build/
build-*/
out/

# CMake cruft (in case of an in-source build)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json
install_manifest.txt

# Editors / IDEs
.vscode/
