!firmware/.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clangd/
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Local secrets / environment
.env
*.pem

# colcon (ROS 2) build output
ros_ws/build/
ros_ws/install/
ros_ws/log/

# Python bytecode cache
__pycache__/
*.pyc
.pytest_cache/
