<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation launch for the SCX24-based autonomous rover.</description>
  <maintainer email="cardonaarmando95@gmail.com">armando</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rover_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- sim_ekf.launch.py only: the EKF and the bridge's sim adapter -->
  <exec_depend>rover_ekf</exec_depend>
  <exec_depend>rover_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
